def make_unique_sheet_name(base: str, existing: set) -> str:
    """Create a valid, unique Excel sheet name up to 31 chars."""
    cleaned = re.sub(r"[\\/*?:\[\]]", "_", s(base).strip())
    cleaned = re.sub(r"\s+", " ", cleaned).strip() or "Analysis"
    cleaned = cleaned[:31]
    candidate = cleaned
    i = 1
    while candidate in existing:
        suffix = f"_{i}"
        candidate = cleaned[: 31 - len(suffix)] + suffix
        i += 1
    existing.add(candidate)
    return candidate


def append_rows(ws, headers: Sequence[str], rows: Iterable[Sequence]) -> None:
    """Append header and rows to a worksheet."""
    ws.append(list(headers))
    for row in rows:
        ws.append([safe_excel_value(v) for v in row])


def style_sheet(ws, freeze: str = "A2", auto_filter: bool = True, wrap_cols: Optional[Iterable[int]] = None) -> None:
    """Apply professional-but-light formatting and safe column widths."""
    header_fill = PatternFill("solid", fgColor="1F4E78")
    header_font = Font(color="FFFFFF", bold=True)
    border = Border(bottom=Side(style="thin", color="BFBFBF"))

    if ws.max_row >= 1:
        for cell in ws[1]:
            cell.fill = header_fill
            cell.font = header_font
            cell.border = border
            cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        ws.freeze_panes = freeze
        if auto_filter and ws.max_column >= 1:
            ws.auto_filter.ref = ws.dimensions

    wrap_cols = set(wrap_cols or [])
    for col_idx in range(1, ws.max_column + 1):
        letter = get_column_letter(col_idx)
        max_len = 0
        for row in range(1, min(ws.max_row, 300) + 1):
            val = ws.cell(row=row, column=col_idx).value
            max_len = max(max_len, len(s(val)))
        width = min(max(max_len + 2, 10), 60)
        if col_idx in wrap_cols:
            width = min(max(width, 25), 80)
            for row in range(2, ws.max_row + 1):
                ws.cell(row=row, column=col_idx).alignment = Alignment(wrap_text=True, vertical="top")
        ws.column_dimensions[letter].width = width

    for row in ws.iter_rows(min_row=2):
        for cell in row:
            if cell.alignment is None or not cell.alignment.wrap_text:
                cell.alignment = Alignment(vertical="top")


def write_kv_summary(ws, metrics: List[Tuple[str, str]], issues: List[Tuple[str, str, int, str, str, str]]) -> None:
    """Write RapidMiner_Conversion_Summary sheet."""
    ws.append(["Metric", "Value"])
    for key, value in metrics:
        ws.append([key, value])

    start = ws.max_row + 3
    ws.cell(row=start, column=1, value="Issue_Type")
    ws.cell(row=start, column=2, value="Source_Sheet")
    ws.cell(row=start, column=3, value="Source_Row")
    ws.cell(row=start, column=4, value="Analysis_Name")
    ws.cell(row=start, column=5, value="RapidMiner_Name")
    ws.cell(row=start, column=6, value="Detail")

    if issues:
        for issue in issues:
            ws.append(list(issue))
    else:
        ws.append(["None", "", "", "", "", "No Excel error strings or CHECK_IF_CONVERSION__ rows found."])

    # Style first header row and issue header row.
    header_fill = PatternFill("solid", fgColor="1F4E78")
    header_font = Font(color="FFFFFF", bold=True)
    for cell in ws[1]:
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = Alignment(horizontal="center")
    for cell in ws[start]:
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = Alignment(horizontal="center")
    ws.freeze_panes = "A2"

    for col_idx in range(1, ws.max_column + 1):
        letter = get_column_letter(col_idx)
        max_len = 0
        for row in range(1, min(ws.max_row, 300) + 1):
            max_len = max(max_len, len(s(ws.cell(row=row, column=col_idx).value)))
        ws.column_dimensions[letter].width = min(max(max_len + 2, 12), 70)


