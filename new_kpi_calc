def replace_prevval_calls(expr: str, occurrences: List[InputOccurrence]) -> str:
    """Convert PrevVal('ABC') to [inp_ABC_Prev] and record an input occurrence."""

    def repl(match: re.Match) -> str:
        quote = match.group(1)
        input_name = match.group(2).strip()
        original, value, rm_name = rapidminer_input_name(input_name, forced_suffix="Prev")
        occurrences.append(InputOccurrence(original, value, rm_name))
        return f"[{rm_name}]"

    # Supports PrevVal('ABC') and PrevVal("ABC") conservatively.
    pattern = re.compile(r"\bPrevVal\s*\(\s*(['\"])(.*?)\1\s*\)", flags=re.IGNORECASE | re.DOTALL)
    return pattern.sub(repl, expr)


def replace_quoted_pi_tags(expr: str, occurrences: List[InputOccurrence]) -> str:
    """Convert single-quoted PI tag references to RapidMiner [inp_*] references."""

    def repl(match: re.Match) -> str:
        raw_name = match.group(1).strip()
        original, value, rm_name = rapidminer_input_name(raw_name)
        occurrences.append(InputOccurrence(original, value, rm_name))
        return f"[{rm_name}]"

    return re.sub(r"'([^']*)'", repl, expr)


def split_top_level_args(arg_text: str) -> List[str]:
    """Split function argument text on top-level commas only.

    Protects commas inside:
      - parentheses
      - [RapidMiner attributes]
      - single-quoted PI strings
      - double-quoted strings
    """
    args: List[str] = []
    start = 0
    paren = 0
    bracket = 0
    in_single = False
    in_double = False
    escape = False

    for i, ch in enumerate(arg_text):
        if in_single:
            # PI AF single-quoted tag names usually escape a quote as two single quotes.
            if ch == "'":
                if i + 1 < len(arg_text) and arg_text[i + 1] == "'":
                    continue
                in_single = False
            continue

        if in_double:
            if ch == "\\" and not escape:
                escape = True
                continue
            if ch == '"' and not escape:
                in_double = False
            escape = False
            continue

        if ch == "'":
            in_single = True
            continue
        if ch == '"':
            in_double = True
            continue
        if ch == "[":
            bracket += 1
            continue
        if ch == "]" and bracket > 0:
            bracket -= 1
            continue
        if bracket:
            continue
        if ch == "(":
            paren += 1
        elif ch == ")" and paren > 0:
            paren -= 1
        elif ch == "," and paren == 0:
            args.append(arg_text[start:i].strip())
            start = i + 1

    last = arg_text[start:].strip()
    if last:
        args.append(last)
    elif arg_text.strip() == "":
        return []
    else:
        args.append("")
    return args

def find_matching_paren(expr: str, open_idx: int) -> int:
    """Return index of the matching closing parenthesis or -1."""
    depth = 0
    bracket = 0
    in_single = False
    in_double = False
    escape = False

    for i in range(open_idx, len(expr)):
        ch = expr[i]

        if in_single:
            if ch == "'":
                if i + 1 < len(expr) and expr[i + 1] == "'":
                    continue
                in_single = False
            continue

        if in_double:
            if ch == "\\" and not escape:
                escape = True
                continue
            if ch == '"' and not escape:
                in_double = False
            escape = False
            continue

        if ch == "'":
            in_single = True
            continue
        if ch == '"':
            in_double = True
            continue
        if ch == "[":
            bracket += 1
            continue
        if ch == "]" and bracket > 0:
            bracket -= 1
            continue
        if bracket:
            continue
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
    return -1

def replace_function_calls(expr: str, function_names: Sequence[str], converter) -> str:
    """
    Replace simple function calls by scanning matching parentheses.

    converter receives a list of top-level argument strings and must return replacement text.
    """
    names = sorted(function_names, key=len, reverse=True)
    pattern = re.compile(r"\b(" + "|".join(re.escape(n) for n in names) + r")\s*\(", flags=re.IGNORECASE)

    pos = 0
    out = []
    while True:
        match = pattern.search(expr, pos)
        if not match:
            out.append(expr[pos:])
            break

        open_idx = expr.find("(", match.start())
        close_idx = find_matching_paren(expr, open_idx)
        if close_idx == -1:
            out.append(expr[pos:])
            break

        out.append(expr[pos: match.start()])
        arg_text = expr[open_idx + 1: close_idx]
        args = split_top_level_args(arg_text)
        out.append(converter(args, match.group(1)))
        pos = close_idx + 1

    return "".join(out)


def strip_outer_quotes(text: str) -> str:
    """Remove one pair of matching single/double quotes from a function argument."""
    text = s(text).strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in {"'", '"'}:
        return text[1:-1].strip()
    return text


def parse_pi_time_offset_minutes(time_text: str) -> Optional[float]:
    """
    Parse common PI relative time expressions into minutes.

    Supported examples:
      '*-1h'   -> -60
      '* - 15m'-> -15
      '*-30s'  -> -0.5
      '*-1d'   -> -1440
      '*+1h'   -> +60, but TagVal conversion will mark it for manual review

    Returns None if the expression is not a simple relative offset from '*'.
    """
    text = strip_outer_quotes(time_text).strip().replace(" ", "")
    if text == "*":
        return 0.0

    match = re.fullmatch(r"\*([+-])(\d+(?:\.\d+)?)([smhdw])", text, flags=re.IGNORECASE)
    if not match:
        return None

    sign = -1.0 if match.group(1) == "-" else 1.0
    amount = float(match.group(2))
    unit = match.group(3).lower()
    unit_to_minutes = {
        "s": 1.0 / 60.0,
        "m": 1.0,
        "h": 60.0,
        "d": 1440.0,
        "w": 10080.0,
    }
    return sign * amount * unit_to_minutes[unit]


def convert_tagval(expr: str, occurrences: List[InputOccurrence], base_interval_minutes: float) -> str:
    """
    Convert PI AF TagVal('TagName','*-1h') to RapidMiner lag([inp_TagName], steps).

    PI TagVal is timestamp-based. RapidMiner lag is row/sample-based, so this
    conversion uses base_interval_minutes to convert time offset to row lag.

    Examples when base_interval_minutes = 60:
      TagVal('Ethylene Storage Inventory','*-1h') -> lag([inp_Ethylene_Storage_Inventory], 1)
      TagVal('ABC','*-2h')                       -> lag([inp_ABC], 2)

    Examples when base_interval_minutes = 15:
      TagVal('ABC','*-1h') -> lag([inp_ABC], 4)
    """
    if base_interval_minutes <= 0:
        raise ValueError("TagVal base interval must be greater than 0 minutes.")

    def conv(args: List[str], _name: str) -> str:
        if len(args) < 2:
            return f"{CHECK_TAGVAL_PREFIX}TagVal({', '.join(args)})"

        raw_tag = strip_outer_quotes(args[0])
        raw_time_arg = args[1]
        offset_minutes = parse_pi_time_offset_minutes(raw_time_arg)

        original, value, rm_name = rapidminer_input_name(raw_tag)
        occurrences.append(InputOccurrence(original, value, rm_name))

        if offset_minutes is None:
            # Keep enough detail for manual correction instead of silently creating bad logic.
            return f"{CHECK_TAGVAL_PREFIX}TagVal([{rm_name}], {raw_time_arg})"

        if offset_minutes == 0:
            return f"[{rm_name}]"

        if offset_minutes > 0:
            # Positive future lookups cannot be represented by lag; flag for review.
            steps_float = offset_minutes / base_interval_minutes
            return f"{CHECK_TAGVAL_PREFIX}lead([{rm_name}], {steps_float:g})"

        steps_float = abs(offset_minutes) / base_interval_minutes
        steps_int = int(round(steps_float))

        if abs(steps_float - steps_int) < 1e-9 and steps_int >= 0:
            return f"lag([{rm_name}], {steps_int})"

        # Non-integer lag rows are unsafe because RapidMiner lag is row-based.
        return f"{CHECK_TAGVAL_INTERVAL_PREFIX}lag([{rm_name}], {steps_float:g})"

    return replace_function_calls(expr, ["TagVal"], conv)


def convert_total(expr: str) -> str:
    """Convert PI Total(a,b,c) to RapidMiner sum(a,b,c)."""

    def conv(args: List[str], _name: str) -> str:
        args = [a for a in args if a.strip()]
        if not args:
            return "MISSING_NUMERIC"
        return f"sum({', '.join(args)})"

    return replace_function_calls(expr, ["Total"], conv)


def convert_badval(expr: str) -> str:
    """Convert BadVal(x) to missing(x)."""

    def conv(args: List[str], _name: str) -> str:
        if not args:
            return "missing(MISSING_NUMERIC)"
        return f"missing({args[0]})"

    return replace_function_calls(expr, ["BadVal"], conv)


def convert_median(expr: str) -> str:
    """Convert Median(lo, val, hi) to min(max(val, lo), hi)."""

    def conv(args: List[str], _name: str) -> str:
        if len(args) >= 3:
            lo, val, hi = args[0], args[1], args[2]
            return f"min(max({val}, {lo}), {hi})"
        # If Median is malformed, keep it obvious for manual checking.
        return f"CHECK_MEDIAN_ARGS__Median({', '.join(args)})"

    return replace_function_calls(expr, ["Median"], conv)


def convert_average(expr: str) -> str:
    """Convert Avg/Average(a,b,c) to ((a + b + c) / 3)."""

    def conv(args: List[str], _name: str) -> str:
        args = [a for a in args if a.strip()]
        if not args:
            return "MISSING_NUMERIC"
        if len(args) == 1:
            return args[0]
        return f"(({ ' + '.join(args) }) / {len(args)})"

    return replace_function_calls(expr, ["Average", "Avg"], conv)


def replace_nooutput(expr: str) -> str:
    return re.sub(r"\bNoOutput\s*\(\s*\)", "MISSING_NUMERIC", expr, flags=re.IGNORECASE)


def replace_logical_operators(expr: str) -> str:
    """Convert PI logical operators to RapidMiner-style operators."""
    expr = re.sub(r"\bAND\b", "&&", expr, flags=re.IGNORECASE)
    expr = re.sub(r"\bOR\b", "||", expr, flags=re.IGNORECASE)
    expr = re.sub(r"\bNOT\b", "!", expr, flags=re.IGNORECASE)
    return expr


def replace_comparison_operators(expr: str) -> str:
    """Convert PI comparison operators without corrupting >=, <=, !=, or ==."""
    expr = expr.replace("<>", "!=")
    expr = re.sub(r"(?<![<>=!])=(?![=])", "==", expr)
    return expr


def convert_internal_variables(expr: str) -> str:
    """
    Convert PI internal variables like vABC to RapidMiner [ABC].

    The scanner avoids changing text already inside [attribute] brackets or double-quoted strings.
    """
    token_pattern = re.compile(r"\b[vV](?=[A-Z_]|v[A-Z])[A-Za-z0-9_]*\b")
    out: List[str] = []
    pos = 0
    bracket = 0
    in_double = False
    escape = False

    i = 0
    while i < len(expr):
        ch = expr[i]
        if in_double:
            if ch == "\\" and not escape:
                escape = True
                i += 1
                continue
            if ch == '"' and not escape:
                in_double = False
            escape = False
            i += 1
            continue
        if ch == '"':
            in_double = True
            i += 1
            continue
        if ch == "[":
            bracket += 1
            i += 1
            continue
        if ch == "]" and bracket > 0:
            bracket -= 1
            i += 1
            continue
        i += 1

    # Easier and safer to rebuild with regex while checking whether each match lies in a protected range.
    protected = build_protected_ranges(expr)

    def in_protected(idx: int) -> bool:
        return any(start <= idx < end for start, end in protected)

    result = []
    last = 0
    for match in token_pattern.finditer(expr):
        if in_protected(match.start()):
            continue
        result.append(expr[last: match.start()])
        result.append(f"[{rapidminer_output_name(match.group(0))}]")
        last = match.end()
    result.append(expr[last:])
    return "".join(result)


def build_protected_ranges(expr: str) -> List[Tuple[int, int]]:
    """Return ranges inside [attributes] and double-quoted strings."""
    ranges: List[Tuple[int, int]] = []
    i = 0
    while i < len(expr):
        if expr[i] == "[":
            start = i
            end = expr.find("]", i + 1)
            if end == -1:
                break
            ranges.append((start, end + 1))
            i = end + 1
            continue
        if expr[i] == '"':
            start = i
            i += 1
            escape = False
            while i < len(expr):
                if expr[i] == "\\" and not escape:
                    escape = True
                    i += 1
                    continue
                if expr[i] == '"' and not escape:
                    i += 1
                    break
                escape = False
                i += 1
            ranges.append((start, i))
            continue
        i += 1
    return ranges


# ---------------------------------------------------------------------------
# PI IF -> RapidMiner if(condition, true_value, false_value)
# ---------------------------------------------------------------------------


def is_word_at(expr: str, idx: int, word: str) -> bool:
    """Case-insensitive whole-word match at idx."""
    if idx < 0 or idx + len(word) > len(expr):
        return False
    if expr[idx: idx + len(word)].lower() != word.lower():
        return False
    before = expr[idx - 1] if idx > 0 else ""
    after = expr[idx + len(word)] if idx + len(word) < len(expr) else ""
    if before and (before.isalnum() or before == "_"):
        return False
    if after and (after.isalnum() or after == "_"):
        return False
    return True


def protected_at(expr: str, idx: int, ranges: List[Tuple[int, int]]) -> bool:
    return any(start <= idx < end for start, end in ranges)


def paren_depth_at(expr: str, idx: int) -> int:
    """Parenthesis depth at idx, ignoring [attributes] and double-quoted strings."""
    depth = 0
    protected = build_protected_ranges(expr)
    p_iter = iter(protected)
    ranges = protected
    i = 0
    while i < idx:
        if protected_at(expr, i, ranges):
            # Jump to the end of the protected range.
            for start, end in ranges:
                if start == i:
                    i = end
                    break
            else:
                i += 1
            continue
        if expr[i] == "(":
            depth += 1
        elif expr[i] == ")" and depth > 0:
            depth -= 1
        i += 1
    return depth


def find_next_pi_if(expr: str, start: int = 0) -> int:
    """Find the next PI IF keyword that is not already RapidMiner if(...)."""
    ranges = build_protected_ranges(expr)
    i = start
    while i < len(expr):
        if protected_at(expr, i, ranges):
            i += 1
            continue
        if is_word_at(expr, i, "If"):
            # Return every IF-like token. Already converted RapidMiner if(...) calls
            # simply will not have a matching THEN/ELSE, so convert_pi_if will skip them.
            # This is necessary because valid PI AF syntax may be lowercase if(... ) Then ...
            return i
        i += 1
    return -1


def find_then_for_if(expr: str, if_idx: int) -> int:
    """Find the THEN that belongs to an IF condition."""
    ranges = build_protected_ranges(expr)
    i = if_idx + 2
    nested_if = 0
    while i < len(expr):
        if protected_at(expr, i, ranges):
            i += 1
            continue
        if is_word_at(expr, i, "If"):
            nested_if += 1
            i += 2
            continue
        if is_word_at(expr, i, "Then"):
            if nested_if == 0:
                return i
            i += 4
            continue
        i += 1
    return -1


def find_else_for_if(expr: str, then_idx: int) -> int:
    """Find the ELSE that belongs to an IF after THEN."""
    ranges = build_protected_ranges(expr)
    i = then_idx + 4
    nested_if = 0
    while i < len(expr):
        if protected_at(expr, i, ranges):
            i += 1
            continue
        if is_word_at(expr, i, "If"):
            nested_if += 1
            i += 2
            continue
        if is_word_at(expr, i, "Else"):
            if nested_if == 0:
                return i
            nested_if -= 1
            i += 4
            continue
        i += 1
    return -1


def find_if_false_end(expr: str, else_value_start: int, base_depth: int) -> int:
    """
    Find where the false branch ends.

    Stops before a top-level comma or a closing parenthesis that belongs to the
    expression outside the IF. This lets expressions like:
      Median(lo, If A Then B Else C, hi)
    become:
      Median(lo, if(A, B, C), hi)
    instead of consuming ', hi'.
    """
    ranges = build_protected_ranges(expr)
    depth = paren_depth_at(expr, else_value_start)
    nested_if = 0
    i = else_value_start

    while i < len(expr):
        if protected_at(expr, i, ranges):
            i += 1
            continue
        if is_word_at(expr, i, "If"):
            nested_if += 1
            i += 2
            continue
        if is_word_at(expr, i, "Else") and nested_if > 0:
            nested_if -= 1
            i += 4
            continue
        ch = expr[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            # If this parenthesis closes an outer expression, the IF branch ends before it.
            if depth == base_depth:
                return i
            if depth > 0:
                depth -= 1
        elif ch == "," and depth == base_depth and nested_if == 0:
            return i
        i += 1
    return len(expr)


def convert_pi_if(expr: str) -> str:
    """Convert all PI AF IF/THEN/ELSE expressions to RapidMiner if(...)."""
    search_pos = 0
    while True:
        if_idx = find_next_pi_if(expr, search_pos)
        if if_idx == -1:
            return expr

        then_idx = find_then_for_if(expr, if_idx)
        if then_idx == -1:
            # Could not safely parse. Leave for final CHECK_IF_CONVERSION__ guard.
            search_pos = if_idx + 2
            continue

        else_idx = find_else_for_if(expr, then_idx)
        if else_idx == -1:
            search_pos = then_idx + 4
            continue

        base_depth = paren_depth_at(expr, if_idx)
        false_start = else_idx + 4
        false_end = find_if_false_end(expr, false_start, base_depth)

        condition = expr[if_idx + 2: then_idx].strip()
        true_value = expr[then_idx + 4: else_idx].strip()
        false_value = expr[false_start: false_end].strip()

        # Recursively convert nested IFs inside each segment.
        condition = convert_pi_if(condition)
        true_value = convert_pi_if(true_value)
        false_value = convert_pi_if(false_value)

        replacement = f"if({condition}, {true_value}, {false_value})"
        expr = expr[:if_idx] + replacement + expr[false_end:]
        search_pos = if_idx + len(replacement)


def convert_formula_to_rapidminer(formula: str, tagval_base_interval_minutes: float = 60.0) -> Tuple[str, List[InputOccurrence]]:
    """Convert one PI AF formula RHS to RapidMiner syntax and return input occurrences."""
    occurrences: List[InputOccurrence] = []
    expr = clean_config_string(formula)

    # Input references first, so PI tags become stable [inp_*] tokens.
    # TagVal must be converted before generic quoted-tag replacement, otherwise
    # its time argument like '*-1h' would incorrectly become an input.
    expr = convert_tagval(expr, occurrences, base_interval_minutes=tagval_base_interval_minutes)
    expr = replace_prevval_calls(expr, occurrences)
    expr = replace_quoted_pi_tags(expr, occurrences)

    # Structural/function conversions.
    expr = convert_pi_if(expr)
    expr = replace_nooutput(expr)
    expr = convert_badval(expr)
    expr = convert_median(expr)
    expr = convert_average(expr)
    expr = convert_total(expr)

    # Variable and operator conversions.
    expr = convert_internal_variables(expr)
    expr = replace_logical_operators(expr)
    expr = replace_comparison_operators(expr)

    # Final safety check: any surviving Then/Else indicates IF parsing ambiguity.
    if re.search(r"\b(Then|Else)\b", expr, flags=re.IGNORECASE):
        expr = CHECK_PREFIX + expr

    return expr.strip(), occurrences


