def build_output_workbook(input_path: Path, output_path: Path, sheet_name: Optional[str] = None, tagval_base_interval_minutes: float = 60.0) -> None:
    input_wb = load_workbook(input_path, data_only=False, read_only=False)
    if sheet_name:
        if sheet_name not in input_wb.sheetnames:
            raise ValueError(f"Sheet '{sheet_name}' not found. Available sheets: {input_wb.sheetnames}")
        src_ws = input_wb[sheet_name]
    else:
        src_ws = input_wb[input_wb.sheetnames[0]]

    name_col, formula_col, mapping_col = find_input_columns(src_ws)

    out_wb = Workbook()
    # Remove default sheet; we will create all sheets explicitly.
    default_ws = out_wb.active
    out_wb.remove(default_ws)

    all_formula_rows: List[FormulaRow] = []
    summaries: List[AnalysisSummary] = []
    sheet_names = set()
    analysis_sheet_rows: Dict[str, List[FormulaRow]] = {}

    for row_idx in range(2, src_ws.max_row + 1):
        analysis_name = s(src_ws.cell(row=row_idx, column=name_col).value).strip()
        formula_config = s(src_ws.cell(row=row_idx, column=formula_col).value)
        mapping_config = s(src_ws.cell(row=row_idx, column=mapping_col).value)

        if not analysis_name and not formula_config and not mapping_config:
            continue
        if not analysis_name:
            analysis_name = f"Analysis_Row_{row_idx}"

        formula_pairs = parse_formula_config(formula_config)
        mapping_rows = parse_variable_mapping(mapping_config)
        lookup = mapping_lookup(mapping_rows)

        out_sheet_name = make_unique_sheet_name(f"A{row_idx-1}_{analysis_name}", sheet_names)
        matched = 0
        current_rows: List[FormulaRow] = []

        for variable, formula in formula_pairs:
            mapping_attr = find_mapping_for_variable(variable, lookup)
            if mapping_attr:
                matched += 1
            rapidminer_var = rapidminer_output_name(variable)
            rapidminer_formula, inputs = convert_formula_to_rapidminer(formula, tagval_base_interval_minutes=tagval_base_interval_minutes)
            fr = FormulaRow(
                source_row=row_idx,
                analysis_name=analysis_name,
                variable_names=variable,
                formulas=formula,
                mapping_attribute=mapping_attr,
                rapidminer_variable_name=rapidminer_var,
                rapidminer_formula=rapidminer_formula,
                input_occurrences=inputs,
            )
            current_rows.append(fr)
            all_formula_rows.append(fr)

        summaries.append(
            AnalysisSummary(
                analysis_name=analysis_name,
                output_sheet_name=out_sheet_name,
                formula_count=len(formula_pairs),
                mapping_count=len(mapping_rows),
                matched_mapping_count=matched,
            )
        )
        analysis_sheet_rows[out_sheet_name] = current_rows

    # 1. Summary
    ws = out_wb.create_sheet("Summary")
    append_rows(
        ws,
        ["Analysis_Name", "Output_Sheet_Name", "Formula_Count", "Mapping_Count", "Matched_Mapping_Count"],
        [
            [x.analysis_name, x.output_sheet_name, x.formula_count, x.mapping_count, x.matched_mapping_count]
            for x in summaries
        ],
    )
    style_sheet(ws)

    # Optional but useful per-analysis sheets referenced by Summary.Output_Sheet_Name.
    analysis_headers = [
        "Source_Row",
        "Analysis_Name",
        "Variable_Names",
        "Formulas",
        "Mapping_Attribute",
        "RapidMiner_Variable_Name",
        "RapidMiner_Formula",
    ]
    for out_sheet_name, rows in analysis_sheet_rows.items():
        ws = out_wb.create_sheet(out_sheet_name)
        append_rows(
            ws,
            analysis_headers,
            [
                [
                    r.source_row,
                    r.analysis_name,
                    r.variable_names,
                    r.formulas,
                    r.mapping_attribute,
                    r.rapidminer_variable_name,
                    r.rapidminer_formula,
                ]
                for r in rows
            ],
        )
        style_sheet(ws, wrap_cols={4, 7})

    # 2. Consolidated_All - preserve all rows and duplicates.
    ws = out_wb.create_sheet("Consolidated_All")
    append_rows(
        ws,
        [
            "Analysis_Name",
            "Variable_Names",
            "Formulas",
            "Mapping_Attribute",
            "RapidMiner_Variable_Name",
            "RapidMiner_Formula",
        ],
        [
            [
                r.analysis_name,
                r.variable_names,
                r.formulas,
                r.mapping_attribute,
                r.rapidminer_variable_name,
                r.rapidminer_formula,
            ]
            for r in all_formula_rows
        ],
    )
    style_sheet(ws, wrap_cols={3, 6})

    # 3. Consolidated_All_RM_input - preserve all input occurrences and duplicates.
    input_occurrence_rows = []
    for r in all_formula_rows:
        for occ in r.input_occurrences:
            input_occurrence_rows.append(
                [
                    r.source_row,
                    r.analysis_name,
                    r.variable_names,
                    r.rapidminer_variable_name,
                    r.mapping_attribute,
                    occ.original_input_name,
                    occ.value,
                    occ.rapidminer_input_name,
                ]
            )

    ws = out_wb.create_sheet("Consolidated_All_RM_input")
    append_rows(
        ws,
        [
            "Source_Row",
            "Analysis_Name",
            "Variable_Names",
            "RapidMiner_Variable_Name",
            "Mapping_Attribute",
            "Original_Input_Name",
            "Value",
            "RapidMiner_Input_Name",
        ],
        input_occurrence_rows,
    )
    style_sheet(ws)

    # 5. Compiled_Formulas - preserve as present in Consolidated_All.
    ws = out_wb.create_sheet("Compiled_Formulas")
    append_rows(
        ws,
        ["Analysis_Name", "RapidMiner_Name", "RapidMiner_Formula"],
        [[r.analysis_name, r.rapidminer_variable_name, r.rapidminer_formula] for r in all_formula_rows],
    )
    style_sheet(ws, wrap_cols={3})

    # 6. Compiled_Inputs - unique master input list only.
    unique_inputs: Dict[Tuple[str, str], Dict[str, object]] = {}
    for row in input_occurrence_rows:
        analysis_name = row[1]
        original_name = row[5]
        value = row[6]
        rapidminer_name = row[7]
        key = (original_name, rapidminer_name)
        if key not in unique_inputs:
            unique_inputs[key] = {
                "analyses": [],
                "original_name": original_name,
                "value": value,
                "rapidminer_name": rapidminer_name,
            }
        analyses: List[str] = unique_inputs[key]["analyses"]  # type: ignore[assignment]
        if analysis_name not in analyses:
            analyses.append(analysis_name)

    ws = out_wb.create_sheet("Compiled_Inputs")
    append_rows(
        ws,
        ["Analysis_Name", "Original_Name", "RapidMiner_Input_Name"],
        [
            ["; ".join(v["analyses"]), v["original_name"], v["rapidminer_name"]]
            for _, v in sorted(unique_inputs.items(), key=lambda item: item[0][1])
        ],
    )
    style_sheet(ws)

    # 7. RapidMiner_Conversion_Summary
    issues: List[Tuple[str, str, int, str, str, str]] = []
    for idx, r in enumerate(all_formula_rows, start=2):  # row in Consolidated_All after header
        combined_text = f"{r.formulas}\n{r.rapidminer_formula}"
        for err in EXCEL_ERROR_STRINGS:
            if err in combined_text:
                issues.append(("Excel_Error_String", "Consolidated_All", idx, r.analysis_name, r.rapidminer_variable_name, f"{err}: {shorten(r.rapidminer_formula)}"))
        if r.rapidminer_formula.startswith(CHECK_PREFIX):
            issues.append(("CHECK_IF_CONVERSION__", "Consolidated_All", idx, r.analysis_name, r.rapidminer_variable_name, shorten(r.rapidminer_formula)))
        if CHECK_TAGVAL_PREFIX in r.rapidminer_formula:
            issues.append(("CHECK_TAGVAL_CONVERSION__", "Consolidated_All", idx, r.analysis_name, r.rapidminer_variable_name, shorten(r.rapidminer_formula)))
        if CHECK_TAGVAL_INTERVAL_PREFIX in r.rapidminer_formula:
            issues.append(("CHECK_TAGVAL_INTERVAL__", "Consolidated_All", idx, r.analysis_name, r.rapidminer_variable_name, shorten(r.rapidminer_formula)))

    ws = out_wb.create_sheet("RapidMiner_Conversion_Summary")
    metrics = [
        ("Total RapidMiner formulas processed", str(len(all_formula_rows))),
        ("Total RapidMiner input occurrences", str(len(input_occurrence_rows))),
        ("Total unique RapidMiner inputs", str(len(unique_inputs))),
        ("Consolidated_All duplicates removed", "No"),
        ("Consolidated_All_RM_input duplicates removed", "No"),
        ("Compiled_Inputs duplicates removed", "Yes, unique master list only"),
        ("TagVal base interval minutes", str(tagval_base_interval_minutes)),
        ("Rows marked CHECK_IF_CONVERSION__", str(sum(1 for r in all_formula_rows if r.rapidminer_formula.startswith(CHECK_PREFIX)))),
        ("Rows marked CHECK_TAGVAL_CONVERSION__", str(sum(1 for r in all_formula_rows if CHECK_TAGVAL_PREFIX in r.rapidminer_formula))),
        ("Rows marked CHECK_TAGVAL_INTERVAL__", str(sum(1 for r in all_formula_rows if CHECK_TAGVAL_INTERVAL_PREFIX in r.rapidminer_formula))),
        ("Rows with Excel error strings", str(sum(1 for issue in issues if issue[0] == "Excel_Error_String"))),
    ]
    write_kv_summary(ws, metrics, issues)

    # Save final workbook.
    output_path.parent.mkdir(parents=True, exist_ok=True)
    out_wb.save(output_path)


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Convert PI AF Analysis Excel export to RapidMiner-ready Excel workbook."
    )
    parser.add_argument("--input", required=True, help="Input PI AF Excel export .xlsx file")
    parser.add_argument("--output", required=True, help="Output RapidMiner-ready .xlsx file")
    parser.add_argument("--sheet", default=None, help="Optional input sheet name. Defaults to the first sheet.")
    parser.add_argument(
        "--tagval-base-minutes",
        type=float,
        default=60.0,
        help="Sampling interval in minutes for converting PI TagVal relative times to RapidMiner row lag. Default: 60.",
    )
    return parser.parse_args(argv)


def validate_paths(input_path: Path, output_path: Path) -> None:
    """Common validation used by both Jupyter and command-line modes."""
    if not input_path.exists():
        raise FileNotFoundError(f"Input file not found: {input_path}")
    if input_path.suffix.lower() not in {".xlsx", ".xlsm"}:
        raise ValueError("Input must be an .xlsx or .xlsm workbook.")
    if output_path.suffix.lower() not in {".xlsx", ".xlsm"}:
        raise ValueError("Output must be an .xlsx or .xlsm workbook.")


def run_pipeline(
    input_file: str | Path = JUPYTER_INPUT_FILE,
    output_file: str | Path = JUPYTER_OUTPUT_FILE,
    sheet_name: Optional[str] = JUPYTER_SHEET_NAME,
    tagval_base_interval_minutes: float = JUPYTER_TAGVAL_BASE_INTERVAL_MINUTES,
) -> Path:
    """
    Jupyter-friendly runner.

    In Notebook, you can call:
        run_pipeline(
            input_file=r"D:\\Your_Folder\\sample_analysis.xlsx",
            output_file=r"D:\\Your_Folder\\pi_af_analysis_rapidminer_final.xlsx",
            sheet_name=None,
            tagval_base_interval_minutes=60.0,
        )

    Or simply update JUPYTER_INPUT_FILE / JUPYTER_OUTPUT_FILE above and run the script.
    """
    input_path = Path(input_file)
    output_path = Path(output_file)

    validate_paths(input_path, output_path)
    build_output_workbook(input_path=input_path, output_path=output_path, sheet_name=sheet_name, tagval_base_interval_minutes=tagval_base_interval_minutes)

    print("RapidMiner-ready workbook created successfully.")
    print(f"Input : {input_path}")
    print(f"Output: {output_path}")
    if sheet_name:
        print(f"Sheet : {sheet_name}")
    else:
        print("Sheet : first sheet in workbook")
    print(f"TagVal base interval minutes: {tagval_base_interval_minutes}")

    return output_path


def running_inside_jupyter() -> bool:
    """Return True when the script is being executed by a Jupyter/IPython kernel."""
    try:
        from IPython import get_ipython  # type: ignore

        shell = get_ipython()
        if shell is None:
            return False
        shell_name = shell.__class__.__name__
        return shell_name in {"ZMQInteractiveShell", "Shell"} or "ipykernel" in sys.modules
    except Exception:
        return False


def main(argv: Optional[Sequence[str]] = None) -> int:
    """Command-line runner using argparse."""
    args = parse_args(argv)
    input_path = Path(args.input)
    output_path = Path(args.output)

    try:
        validate_paths(input_path, output_path)
        build_output_workbook(input_path=input_path, output_path=output_path, sheet_name=args.sheet, tagval_base_interval_minutes=args.tagval_base_minutes)
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    print(f"Created RapidMiner-ready workbook: {output_path}")
    return 0


