# ---------------------------------------------------------------------------
# Generic helpers
# ---------------------------------------------------------------------------


def s(value) -> str:
    """Return a clean string for blank-safe processing."""
    if value is None:
        return ""
    return str(value)


def normalize_header(text: str) -> str:
    """Normalize headers so minor case/spelling/space differences do not break detection."""
    return re.sub(r"[^a-z0-9]", "", s(text).strip().lower())


def find_input_columns(ws) -> Tuple[int, int, int]:
    """
    Detect input columns by header name. Falls back to A/B/C if needed.

    Handles headers like:
      Name
      AnalysisRuleConfigString
      AnalysisRuleVariableMapping
    and case variants such as AnalysisRUleVariableMapping.
    """
    header_to_col: Dict[str, int] = {}
    for cell in ws[1]:
        header_to_col[normalize_header(cell.value)] = cell.column

    name_col = header_to_col.get("name", 1)
    formula_col = header_to_col.get("analysisruleconfigstring", 2)
    mapping_col = header_to_col.get("analysisrulevariablemapping", 3)
    return name_col, formula_col, mapping_col


def clean_config_string(text: str) -> str:
    """Apply required cleaning before splitting PI AF config strings."""
    text = s(text).replace("_x000D_", "")
    text = text.replace(":= ", ":=")
    return text.strip()


def sanitize_name(name: str, default: str = "Name") -> str:
    """
    Sanitize a PI tag/variable name into a RapidMiner-safe attribute name part.

    - trims leading/trailing blanks
    - replaces invalid characters with underscores
    - collapses repeated underscores
    - avoids blank names and leading digits
    """
    name = s(name).strip()
    name = re.sub(r"[^A-Za-z0-9_]+", "_", name)
    name = re.sub(r"_+", "_", name).strip("_")
    if not name:
        name = default
    if re.match(r"^\d", name):
        name = "_" + name
    return name


def split_known_suffix(input_name: str, forced_suffix: str = "") -> Tuple[str, str]:
    """
    Split known PI input suffixes from a tag name.

    Examples:
      ABC|Lo   -> (ABC, Lo)
      ABC|Hi   -> (ABC, Hi)
      PrevVal('ABC') is handled by forced_suffix='Prev' -> (ABC, Prev)
    """
    clean = s(input_name).strip()
    if forced_suffix:
        return clean, forced_suffix

    for suffix in KNOWN_INPUT_SUFFIXES:
        marker = "|" + suffix
        if clean.endswith(marker):
            return clean[: -len(marker)].strip(), suffix
    return clean, ""


def rapidminer_input_name(input_name: str, forced_suffix: str = "") -> Tuple[str, str, str]:
    """
    Build RapidMiner input name and return:
      (original_base_name, suffix_value, rapidminer_name_without_brackets)
    """
    base, suffix = split_known_suffix(input_name, forced_suffix=forced_suffix)
    base_part = sanitize_name(base, default="Input")
    if suffix:
        return base, suffix, f"inp_{base_part}_{sanitize_name(suffix, default='Value')}"
    return base, "", f"inp_{base_part}"


def rapidminer_output_name(variable_name: str) -> str:
    """
    Convert PI AF internal variable/output names to RapidMiner output names.

    Per requirement: variables starting with v remove the leading v.
    Only one leading v/V is removed intentionally. Example:
      vABC  -> ABC
      vvABC -> vABC
    """
    var = s(variable_name).strip()
    if len(var) > 1 and var[0].lower() == "v":
        var = var[1:]
    return sanitize_name(var, default="Output")


def safe_excel_value(value):
    """Write formula-like text literally, not as an Excel formula."""
    if isinstance(value, str) and value.startswith("="):
        return "'" + value
    return value


def shorten(text: str, limit: int = 300) -> str:
    text = s(text)
    if len(text) <= limit:
        return text
    return text[: limit - 3] + "..."


# ---------------------------------------------------------------------------
# PI AF config parsing
# ---------------------------------------------------------------------------


def parse_formula_config(config_string: str) -> List[Tuple[str, str]]:
    """
    Split AnalysisRuleConfigString into (Variable_Names, Formulas) rows.

    Required behavior:
      1. Replace _x000D_ with blank.
      2. Replace ':= ' with ':='.
      3. Split using semicolon.
      4. Split each formula row using ':='.
    """
    cleaned = clean_config_string(config_string)
    rows: List[Tuple[str, str]] = []

    for part in cleaned.split(";"):
        item = part.strip()
        if not item:
            continue
        if ":=" in item:
            variable, formula = item.split(":=", 1)
            rows.append((variable.strip(), formula.strip()))
        else:
            # Keep malformed/partial formula rows instead of silently dropping them.
            rows.append(("", item.strip()))
    return rows


def parse_variable_mapping(mapping_string: str) -> List[Tuple[str, str]]:
    """
    Split AnalysisRuleVariableMapping into (Variable_Names, Mapping_Attribute) rows.

    Required behavior:
      1. Split using semicolon.
      2. Split using ' || ' / '||'.
      3. Preserve Mapping_Attribute.
    """
    cleaned = clean_config_string(mapping_string)
    rows: List[Tuple[str, str]] = []

    for part in cleaned.split(";"):
        item = part.strip()
        if not item:
            continue
        if "||" in item:
            variable, attribute = item.split("||", 1)
            rows.append((variable.strip(), attribute.strip()))
        else:
            rows.append((item.strip(), ""))
    return rows


def mapping_lookup(mapping_rows: Sequence[Tuple[str, str]]) -> Dict[str, str]:
    """
    Create a mapping dictionary with exact and normalized keys.

    This improves join robustness if the source uses whitespace or v-prefix variants.
    """
    lookup: Dict[str, str] = {}
    for variable, attribute in mapping_rows:
        if not variable:
            continue
        keys = {
            variable.strip(),
            normalize_key(variable),
            rapidminer_output_name(variable),
        }
        for key in keys:
            if key and key not in lookup:
                lookup[key] = attribute
    return lookup


def normalize_key(name: str) -> str:
    return sanitize_name(s(name).strip(), default="Name").lower()


def find_mapping_for_variable(variable: str, lookup: Dict[str, str]) -> str:
    """Find Mapping_Attribute for a formula variable."""
    possible = [
        variable.strip(),
        normalize_key(variable),
        rapidminer_output_name(variable),
    ]
    for key in possible:
        if key in lookup:
            return lookup[key]
    return ""


